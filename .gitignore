# configuração pessoal do Claude Code
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# intermediários da montagem (refeitos pelo montar.py)
piloto/*/clipes/
piloto/*/lista.txt
piloto/*/audio_mix_bruto.wav

# vídeos de referência baixados (centenas de MB; os quadros em ink-explainer/ e diario-nada-normal/ ficam versionados)
pesquisa/referencias-visuais/videos/

# credenciais e token do YouTube (nunca versionar)
ferramentas/.youtube/

# vídeos finais e brutos (não sobem para o GitHub)
*.mp4
*.webm
*.mov
*.mkv

# áudio intermediário pesado (refeito pelos scripts); as vozes de referência em identidade/ ficam
piloto/**/*.wav
!piloto/testes-identidade/**/*.wav

# temporários e arquivos vazios
ferramentas/_x
piloto/*/tmp/

# imagens geradas dos vídeos 6 a 14 (~2 GB; os scripts e prompts as recriam). As folhas de contato (folhas/) e thumbs ficam como amostra.
piloto/v6-camponesa-medieval/imagens/
piloto/v7-pompeia/imagens/
piloto/v11-oregon-trail/imagens/
piloto/v12-resident-evil/imagens/
piloto/v12-resident-evil/imagens_final/
piloto/v12-resident-evil/teste_klein/*.png
piloto/v13-bloods-nova-york/imagens/
piloto/v13-bloods-nova-york/imagens_final/
piloto/v14-backrooms/imagens/
piloto/v14-backrooms/imagens_final/
